            "fd/databases-101",
            "sd/client-server-architecture",
            "sd/ip-address",
            "sd/domain-name-system-dns",
            "sd/tcp-vs-udp"
          ],
          "assessments": []
        },
        "Senior": {
          "expectation": "Reasons about latency, connection reuse, TLS and proxies on the real request path and sizes the edge (load balancers, CDN) for a service they own.",
          "lessons": [
            "sd/osi",
            "sd/http-https",
            "sd/ssl-tls",
            "sd/forward-and-reverse-proxies",
            "sd/load-balancers",
