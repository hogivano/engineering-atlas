    {
      "id": "systems-fundamentals",
      "name": "Systems fundamentals",
      "summary": "How code, operating systems and networks actually run underneath a service: processes, memory, TCP/IP, DNS, HTTP and the edge.",
      "levels": {
        "Mid": {
          "expectation": "Explains what happens between a user's click and a database row, and debugs a slow or failing request with the shell, logs and basic network tools.",
          "lessons": [
            "fd/how-computers-run-code",
            "fd/processes-threads-async",
            "fd/networking-basics",
            "fd/http-and-the-web",
            "fd/linux-command-line",
