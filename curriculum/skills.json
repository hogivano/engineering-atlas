        "Staff": {
          "expectation": "Sets the platform shape for many teams (containers, orchestration, service mesh, global traffic routing) and explains which layer a cross-team failure lives in.",
          "lessons": [
            "sd/anycast-routing",
            "sd/dns-load-balancing",
            "sd/webrtc",
            "sd/service-mesh",
            "sd/sidecar-pattern",
